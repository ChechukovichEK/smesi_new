AddDefaultCharset utf-8
RewriteEngine On

# Редирект на HTTPS
# cpanel2ispmgr: disabled HTTPS redirect (cyclic behind ISP SSL termination)
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Редирект с www на без www
# cpanel2ispmgr: disabled HTTPS redirect (cyclic behind ISP SSL termination)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Убираем знак вопроса в конце URL (/?)
RewriteCond %{THE_REQUEST} ^[^\s]+\s+[^?]*?\?
RewriteCond %{QUERY_STRING} ^$
RewriteRule .? %{REQUEST_URI}? [R=301,L]

# Удаление слеша в конце URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Редирект для URL с запятой в конце параметров
RewriteCond %{QUERY_STRING} ^(.+),$ [NC]
RewriteRule ^(.*)$ /$1?%1 [R=301,L]

# Если в URL есть параметр block=..., перенаправляем на URL без него
RewriteCond %{QUERY_STRING} (.*)(^|&)block=[^&]+(&|$) [NC]
RewriteRule ^(.*)$ /$1?%1%3 [R=301,L,NE]

# Редиректы со старых адресов
Redirect 301 /?__im-ExODtFYd=11889498768758190612 https://smesi.by
Redirect 301 /?yandex-source=touch-maps https://smesi.by
Redirect 301 /home https://smesi.by
Redirect 301 /? https://smesi.by
Redirect 301 /school https://smesi.by/article
Redirect 301 /article/kak-opredelit-sya-s-vyborom-nailuchshego-teploizolyacionnogo-materiala-dlya-konkretnyh-stroitel-nyh-nuzhd https://smesi.by/article/kak-vybrat-teploizolyacionnyj-material
Redirect 301 /page/kontakty https://smesi.by/contacts

# убирает index.php
#===================================================
RewriteCond %{THE_REQUEST} ^GET.*index\.php [NC]
RewriteRule ^(.*?)index\.php/*(.*) /$1$2 [R=301,NE,L]

# Дубли страниц index.html
# cpanel2ispmgr: disabled HTTPS redirect (cyclic behind ISP SSL termination)
# RewriteCond %{REQUEST_URI} ^(.*)/index\.html$
# RewriteRule ^(.*)index\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

# Кеширование статичных файлов
# ===========================
<IfModule mod_expires.c>
  ExpiresActive On

  # Картинки
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Шрифты
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"

  # CSS и JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Редирект на папку public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]